    "Modeling": {
        "CV": ["torchvision", "Kornia", "Anomalib", "Lightly"],
        "NLP/LLM": ["Transformers", "HuggingFace"],
        "SciAI": ["NVIDIA 科学计算套件"]
    },
    "Training": {
        "Base": ["PyTorch Ignite"],
        "Distributed": ["DeepSpeed", "RAY"],
        "Privacy": ["Opacus"],
